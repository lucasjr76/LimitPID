cmd_connections()
{
    need_root "$@"

    cleanup_orphans quiet

    local json=0 all=0 pid="" arg
    for arg in "$@"; do
        case "$arg" in
            --json) json=1 ;;
            --all)  all=1 ;;
            *)
                if [[ -z "$pid" && "$arg" =~ ^[0-9]+$ ]]; then
                    pid="$arg"
                else
                    die "uso: limitpid connections [PID] [--json] [--all]"
                fi
                ;;
        esac
    done

    build_net_helper "$json"

    local args=(connections)
    [[ -n "$pid" ]] && args+=("$pid")
    (( json )) && args+=(--json)
    (( all )) && args+=(--all)

    exec "$NET_HELPER" "${args[@]}"
}

cmd_processes()
{
    need_root "$@"

    cleanup_orphans quiet

    local json=0 all=0 arg
    for arg in "$@"; do
        case "$arg" in
            --json) json=1 ;;
            --all)  all=1 ;;
            *) die "uso: limitpid processes [--json] [--all]" ;;
        esac
    done

    # Snapshot de processos limitados usa os contadores do loader.
    if (( json )); then
        build_loader >/dev/null
    else
        build_loader
    fi
    build_net_helper "$json"

    local args=(processes)
    (( json )) && args+=(--json)
    (( all )) && args+=(--all)
    exec "$NET_HELPER" "${args[@]}"
}

cmd_snapshot()
{
    need_root "$@"

    # Principal gatilho do GC na GUI. "quiet" é obrigatório:
    # stdout de snapshot precisa continuar sendo JSON puro.
    cleanup_orphans quiet

    local all=0 arg
    for arg in "$@"; do
        case "$arg" in
            --json) : ;; # aceito por ergonomia; snapshot já é JSON.
            --all) all=1 ;;
            *) die "uso: limitpid snapshot [--json] [--all]" ;;
        esac
    done

    # stdout deve conter SOMENTE JSON para a GUI.
    build_loader >/dev/null
    build_net_helper 1

    local args=(snapshot)
    (( all )) && args+=(--all)
    exec "$NET_HELPER" "${args[@]}"
}

cmd_json()
{
    cmd_snapshot --json "$@"
}


cmd_list()
{
    need_root "$@"

    cleanup_orphans quiet

    echo
    printf "%-10s %-22s %-12s %-12s\n" "PID" "PROCESSO" "DOWNLOAD" "UPLOAD"
    printf "%-10s %-22s %-12s %-12s\n" "----------" "----------------------" "------------" "------------"

    local d pid down up
    for d in "$RUNROOT"/[0-9]*; do
        [[ -d "$d" ]] || continue
        pid="${d##*/}"
        down=$(cat "$d/down" 2>/dev/null || echo "?")
        up=$(cat "$d/up" 2>/dev/null || echo "?")
        printf "%-10s %-22s %-12s %-12s\n" "$pid" "$(get_comm "$pid")" "$down" "$up"
    done

    local cgdir nome
    if [[ -d "$CGRUN" ]] && compgen -G "$CGRUN/*" >/dev/null; then
        echo
        printf "%-10s %-22s %-12s %-12s\n" "CONTAINER" "" "DOWNLOAD" "UPLOAD"
        printf "%-10s %-22s %-12s %-12s\n" "----------" "----------------------" "------------" "------------"
        for cgdir in "$CGRUN"/*; do
            [[ -d "$cgdir" ]] || continue
            nome=$(cat "$cgdir/name" 2>/dev/null || echo "${cgdir##*/}")
            local marca=""
            [[ "$(cg_estado "${cgdir##*/}")" == "morto" ]] && marca="  ${RED}<< MORTO: reaplique${RESET}"
            printf "%-10s %-22.22s %-12s %-12s%b\n" "cgroup" "$nome" \
                "$(cat "$cgdir/down" 2>/dev/null || echo '?')" \
                "$(cat "$cgdir/up" 2>/dev/null || echo '?')" "$marca"
        done
    fi
    echo
}

usage()
{
    cat <<EOF

limitpid $VERSION

Limitação de banda por PID usando cgroup v2 + eBPF.
Sem tc, iptables ou nftables.

USO:
    limitpid PID DOWNLOAD UPLOAD
    limitpid apply PID DOWNLOAD UPLOAD [--reset-connections]
    limitpid change PID DOWNLOAD UPLOAD
    limitpid status PID
    limitpid remove PID
    limitpid run DOWNLOAD UPLOAD COMANDO [ARGS...]

    limitpid containers                              # lista containers Docker
    limitpid cgroup CONTAINER DOWNLOAD UPLOAD        # limita um container
    limitpid cgroup-change CONTAINER DOWNLOAD UPLOAD
    limitpid cgroup-remove CONTAINER

    limitpid list
    limitpid gc
    limitpid top [INTERVALO_SEGUNDOS]
    limitpid processes [--json] [--all]
    limitpid tree [--json] [--all]
    limitpid connections [PID] [--json] [--all]
    limitpid snapshot [--json] [--all]
    limitpid json [--all]

EXEMPLOS:
    sudo limitpid 12345 10M 2M
    sudo limitpid apply 12345 10M 2M
    sudo limitpid change 12345 20M 5M
    sudo limitpid run 10M 2M firefox
    sudo limitpid run 5M 1M curl -o /dev/null https://fsn1-speed.hetzner.com/100MB.bin
    sudo limitpid status 12345
    sudo limitpid remove 12345
    sudo limitpid top
    sudo limitpid top 0.5
    sudo limitpid processes
    sudo limitpid tree
    sudo limitpid connections
    sudo limitpid connections 12345
    sudo limitpid connections --json
    sudo limitpid snapshot --json

UNIDADES:
    K = kbit/s
    M = Mbit/s
    G = Gbit/s

OBJETO BPF GENÉRICO:
    $BPF_OBJ

O objeto é compilado uma vez. "change" altera apenas o BPF map de configuração,
sem recompilar, sem detach e sem mover processos.

BACKEND PARA GUI (v0.4.3):
    processes   lista processos de rede e raízes de limitador, sem duplicar filhos auxiliares
    connections lista conexões/sockets IPv4/IPv6 e seus PIDs
    tree        mostra cada limitador como grupo e seus processos membros
    snapshot    entrega JSON estável (schema 2) e coleta limitadores órfãos
    gc          força uma varredura manual de limitadores órfãos

Por padrão LISTEN/TIME_WAIT, UDP sem peer e sockets órfãos são ocultados. Use --all para incluí-los.

GARBAGE COLLECTOR (v0.4.3):
    - grupos em criação são protegidos por .creating
    - cgroup populated=1 nunca é removido, mesmo se o PID raiz morrer
    - cgroup populated=0 é coletado automaticamente no próximo snapshot/comando
    - remoção segura: rmdir do cgroup (teste atômico) antes de destruir pins/estado
    - serializado por lock (flock) com apply/change/remove
    - não há daemon residente adicional

NOVIDADES v0.5.0 -- CONTAINERS:
    Downloads de containers (ollama, docker pull, etc.) NÃO são limitáveis pelo
    PID que aparece no host: o cliente só conversa por loopback e quem baixa é o
    processo dentro do container. Use o modo cgroup:

        sudo limitpid containers
        sudo limitpid cgroup ollama 2M 1M
        sudo limitpid cgroup-change ollama 10M 2M
        sudo limitpid cgroup-remove ollama

    Nesse modo nenhum processo é movido: o eBPF é anexado ao cgroup que o Docker
    já criou. Vale inclusive para downloads em andamento, sem derrubar conexão.

    NADA É PERSISTENTE. Estado em /run (tmpfs) e pins em bpffs somem ao reiniciar
    a máquina. Container parado ou recriado perde o limite (o GC limpa o resíduo).

COMO O FILTRO ESCOLHE O TRÁFEGO (medido, não suposto):
    Programas cgroup_skb filtram pelo cgroup do SOCKET, carimbado quando o
    socket é criado -- não pelo cgroup atual do processo. Consequências:

      - conexão aberta ANTES do primeiro apply nunca é limitada (o socket
        nasceu fora); apply avisa quantas são. Use --reset-connections para
        derrubá-las e deixar o cliente reconectar já limitado.
      - remove NÃO destrói o cgroup: os sockets vivos continuam presos a ele.
        Um apply seguinte reutiliza o mesmo cgroup e o limite volta a valer
        nas conexões em andamento, sem derrubar nada.
      - change nunca derruba nada: só atualiza o BPF map.

NOVIDADES v0.4.4:
    - remove preserva o cgroup por DETACHED_TTL (${DETACHED_TTL}s); apply o
      reutiliza e religa o limite sem quebrar downloads em andamento
    - apply não derruba mais conexões por padrão: apenas avisa
      (--reset-connections força o comportamento antigo)
    - GC coleta os cgroups preservados após o TTL

NOVIDADES v0.4.3:
    - lock global com liberação explícita (run não segura mais o lock)
    - GC remove na ordem segura (rmdir do cgroup antes dos pins)
    - helper python re-extraído automaticamente a cada nova versão

Nesta versão a limitação continua sendo por processo/cgroup. O controle individual
por socket/conexão fica reservado para a próxima etapa, sem quebrar a API JSON.

EOF
}

case "${1:-}" in
    apply)  shift; cmd_apply "$@" ;;
    change) shift; cmd_change "$@" ;;
    status) shift; cmd_status "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    run)    shift; cmd_run "$@" ;;
    list)           shift; cmd_list "$@" ;;
    containers)     shift; cmd_containers "$@" ;;
    cgroup)         shift; cmd_cgroup "$@" ;;
    cgroup-change)  shift; cmd_cgroup_change "$@" ;;
    cgroup-remove)  shift; cmd_cgroup_remove "$@" ;;
    gc)          shift; cmd_gc "$@" ;;
    top)         shift; cmd_top "$@" ;;
    processes)   shift; cmd_processes "$@" ;;
    tree)        shift; cmd_tree "$@" ;;
    connections) shift; cmd_connections "$@" ;;
    snapshot)    shift; cmd_snapshot "$@" ;;
    json)        shift; cmd_json "$@" ;;
    -h|--help|help|"") usage ;;
    *)
        if [[ "${1:-}" =~ ^[0-9]+$ ]] && [[ $# -eq 3 ]]; then
            cmd_apply "$@"
        else
            die "comando desconhecido: $1"
        fi
        ;;
esac
